---
/** 12-facility grid with photo thumbnails — 2 cols mobile → 4 cols desktop (spec §6.10). */
import { Image } from 'astro:assets';
import { ui, t, type Lang } from '../i18n/ui';
import { amenities } from '../content';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import bgAmenities from '../assets/img/amenities-bg.webp';

/** Photo thumbnail per icon key; falls back to the inline SVG when missing. */
const iconPhotos = import.meta.glob<{ default: ImageMetadata }>('../assets/img/icons/*.webp', {
  eager: true,
});
const photo = (name: string) => iconPhotos[`../assets/img/icons/${name}.webp`]?.default;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section id="amenities" class="section-pad relative isolate overflow-hidden bg-white">
  <Image
    src={bgAmenities}
    alt=""
    widths={[900, 1400, 1600]}
    sizes="100vw"
    quality={45}
    loading="lazy"
    aria-hidden="true"
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-30"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-white via-white/55 to-white"
    aria-hidden="true"
  >
  </div>

  <div class="container-c relative">
    <SectionHeading
      eyebrow={t(ui.sections.amenitiesEyebrow, lang)}
      title={t(ui.sections.amenitiesTitle, lang)}
    />

    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4" role="list">
      {
        amenities.map((a, i) => (
          <li class="reveal card flex items-center gap-3.5 bg-white/85 px-4 py-4 backdrop-blur-sm sm:px-5 sm:py-5">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-gold/15 text-gold shadow-sm ring-1 ring-gold/30 sm:h-14 sm:w-14">
              {photo(a.icon) ? (
                <Image
                  src={photo(a.icon)!}
                  alt=""
                  width={112}
                  height={112}
                  quality={80}
                  loading="lazy"
                  aria-hidden="true"
                  class="h-full w-full object-cover"
                />
              ) : (
                <Icon name={a.icon} class="h-[22px] w-[22px]" />
              )}
            </span>
            <span class="font-medium leading-snug text-navy">
              <span class="mr-1.5 font-display text-xs font-bold text-gold/70" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {t(a.label, lang)}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
